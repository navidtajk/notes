% Theorems and such
\newtheorem{lemma}{Lemma}
\newtheorem{theorem}{Theorem}

\theoremstyle{definition}
\newtheorem{definition}{Def}

\theoremstyle{remark}
\newtheorem*{remark}{Remark}

\newtheorem*{exercise}{Exercise}

\theoremstyle{remark}
\newtheorem*{nudge}{Nudge} % To get the reader to think, but not literally an exercise

\newenvironment{algo}
{
  \begin{tabular}{|l|}
    \hline
    \begin{minipage}{1in}
      \begin{tabbing}
        \quad\=\qquad\=\qquad\=\qquad\=\qquad\=\qquad\=\qquad\=\qquad\=\qquad\=\qquad\=\qquad\=\qquad\=\qquad\=\kill
          }{
      \end{tabbing}
    \end{minipage}
    \\\hline
  \end{tabular}
}
\newenvironment{centeralgo}{\begin{center}\begin{algo}}{\end{algo}\end{center}}

\def\Comment#1{\textsf{\textsl{\textcolor{BrickRed}{$\langle\!\langle$#1\/$\rangle\!\rangle$}}}}

% Basic stuff
\def\defeq{\overset{\text{def}}{=}}
\def\ddx{\frac{d}{dx}}
\def\d#1{\ensuremath{\operatorname{d}\!{#1}}}

\def\eps{\varepsilon}
\def\Cdot{\mathbin{\text{\normalfont \textbullet}}}
\let\oldemptyset\emptyset
\let\emptyset\varnothing


% Sets
\def\Z{\mathbb{Z}}
\def\R{\mathbb{R}}
\def\Q{\mathbb{Q}}
\def\N{\mathbb{N}}
\def\C{\mathbb{C}}

% Delimiters
\def\paren#1{\mleft(#1\mright)}
\def\brack#1{\mleft[#1\mright]}
\def\brace#1{\mleft\{#1\mright\}}
\def\anglebrack#1{\mleft\langle #1 \mright\rangle}
\def\bars#1{\mleft|#1\mright|}
\def\floor#1{\mleft\lfloor#1\mright\rfloor}
\def\ceil#1{\mleft\lceil #1 \mright\rceil}

% \newfunction[<wrapper>]{<command>}{<symbol>}
\NewDocumentCommand{\newfunction}{O{\paren} m m}{%
  \DeclareDocumentCommand{#2}{e{_} g e{_}}{%
    #3%
    \IfValueTF{##1}{_{##1}}{%
      \IfValueT{##3}{_{##3}}%
    }%
    \IfValueT{##2}{#1{##2}}%
  }%
}

% Semantic aliases
\def\Set#1{\brace{#1}}
\def\sizeof#1{\bars{#1}}

% Convenience
\def\prac#1#2{\paren{\frac{#1}{#2}}}

%%%% Algo functions %%%%
\newfunction{\bigO}{O}
\newfunction{\bigTheta}{\Theta}
\newfunction{\bigOmega}{\Omega}
\newfunction{\apxO}{\widetilde{O}}
\newfunction{\poly}{\operatorname{poly}}

%%%% Graphs %%%%
\newfunction{\cut}{\partial}
\newfunction{\outcut}{\partial^+}
\newfunction{\incut}{\partial^-}
\newfunction{\ball}{B}
\newfunction{\outball}{B^+}
\newfunction{\inball}{B^-}
\newfunction{\inoutball}{B^\pm}
\newfunction{\deg}{\operatorname{deg}}
\newfunction{\indeg}{\operatorname{deg}^-}
\newfunction{\outdeg}{\operatorname{deg}^+}
\newfunction{\len}{\ell}
\newfunction{\dist}{d}


%%%% Probability %%%%
\newfunction[\brack]{\Pr}{\operatorname{Pr}}
\newfunction[\brack]{\E}{\operatorname{E}}
\newfunction{\Var}{\operatorname{Var}}
\newfunction{\Cov}{\operatorname{Cov}}

\mathchardef\hyphen="2D

% Algebra Operators
\DeclareMathOperator{\Span}{span}
\DeclareMathOperator{\Null}{null}
\DeclareMathOperator{\rank}{rank}
\DeclareMathOperator{\Hom}{Hom}
\DeclareMathOperator{\Alt}{Alt}
\DeclareMathOperator{\Aut}{Aut}
\DeclareMathOperator{\Map}{Map}
\DeclareMathOperator{\Bilin}{Bilin}
\DeclareMathOperator{\tr}{tr}
\DeclareMathOperator{\sign}{sign}
\DeclareMathOperator{\id}{id}
\DeclareMathOperator{\im}{im}


\NewDocumentEnvironment{xydiagram}{ +b }{
  \[
    \xymatrix{#1}
  \]
}{}

\DeclarePairedDelimiter{\norm}{\lVert}{\rVert}
